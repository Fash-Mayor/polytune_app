{
  "expo": {
    "name": "PolyTune",
    "slug": "lyricsmine",
    "scheme": "polytune",
    "version": "1.3.2",
    "orientation": "portrait",
    "icon": "./assets/PolyTuneLogo.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-localization",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/PolyTuneLogo.png",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0da6be6a-07fb-4ecc-bb6a-80d0cb83ed21"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/0da6be6a-07fb-4ecc-bb6a-80d0cb83ed21",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/PolyTuneLogo.png",
        "monochromeImage": "./assets/PolyTuneLogo.png"
      },
      "splash": {
        "backgroundColor": "#000000",
        "image": "./assets/PolyTuneLogo.png",
        "resizeMode": "contain",
        "dark": {
          "backgroundColor": "#000000",
          "image": "./assets/PolyTuneLogo.png"
        }
      },
      "notificationIcon": "./assets/PolyTuneLogo.png",
      "package": "com.fashmayor.lyricsmine",
      "predictiveBackGestureEnabled": false
    }
  }
}
