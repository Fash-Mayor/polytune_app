{
  "expo": {
    "name": "lyricsmine",
    "slug": "lyricsmine",
    "scheme": "lyricsmine",
    "version": "3.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0da6be6a-07fb-4ecc-bb6a-80d0cb83ed21"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0da6be6a-07fb-4ecc-bb6a-80d0cb83ed21"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon.png",
        "backgroundImage": "./assets/android-icon.png",
        "monochromeImage": "./assets/android-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fashmayor.lyricsmine"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
