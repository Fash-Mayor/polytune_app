{
  "expo": {
    "name": "LyricsMine",
    "slug": "lyricsmine",
    "scheme": "lyricsmine",
    "version": "3.1.1",
    "orientation": "portrait",
    "icon": "./assets/main.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "splash": {
      "image": "./assets/main.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-splash-screen"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0da6be6a-07fb-4ecc-bb6a-80d0cb83ed21"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0da6be6a-07fb-4ecc-bb6a-80d0cb83ed21"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/main.png",
        "monochromeImage": "./assets/main.png"
      },
      "notificationIcon": "./assets/android-icon-192x192.png",
      "package": "com.fashmayor.lyricsmine",
      "predictiveBackGestureEnabled": false
    }
  }
}
